#!/usr/bin/env bash
# 把 extensions/skills 里每个 skill 以相对软链挂到 .agents/skills。
# vendor 拷贝（npx skills 装进来的实体目录）不动；只管理指向 source 的那批链。
set -euo pipefail

usage() {
  cat <<'EOF'
usage: link-agent-skills [--check] [--dry-run] [--source DIR] [--dest DIR]
                         [--self-test] [-h|--help]

Link each skill in extensions/skills into .agents/skills as a relative
symlink. Idempotent. Vendor copies already in dest are left alone.

  --check      verify links; write nothing; exit 1 if out of sync
  --dry-run    print actions; write nothing
  --source     skill source dir (default: <repo>/extensions/skills)
  --dest       hub dir (default: <repo>/.agents/skills)
  --self-test  run against a temp tree and exit
EOF
}

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SOURCE="$REPO_ROOT/extensions/skills"
DEST="$REPO_ROOT/.agents/skills"
CHECK=0
DRY_RUN=0
SELF_TEST=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --check) CHECK=1; shift ;;
    --dry-run) DRY_RUN=1; shift ;;
    --self-test) SELF_TEST=1; shift ;;
    --source)
      SOURCE="${2:?--source requires a directory}"
      shift 2
      ;;
    --dest)
      DEST="${2:?--dest requires a directory}"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "error: unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

abspath() {
  python3 -c 'import os,sys; print(os.path.abspath(sys.argv[1]))' "$1"
}

relpath() {
  python3 -c 'import os,sys; print(os.path.relpath(sys.argv[1], sys.argv[2]))' "$1" "$2"
}

normjoin() {
  python3 -c 'import os,sys; print(os.path.normpath(os.path.join(sys.argv[1], sys.argv[2])))' "$1" "$2"
}

is_under() {
  python3 -c '
import os, sys
child, parent = os.path.normpath(sys.argv[1]), os.path.normpath(sys.argv[2])
ok = child == parent or child.startswith(parent + os.sep)
print("yes" if ok else "no")
' "$1" "$2"
}

SOURCE="$(abspath "$SOURCE")"
DEST="$(abspath "$DEST")"

list_skills() {
  local dir="$1"
  (
    shopt -s nullglob
    for path in "$dir"/*; do
      name="$(basename "$path")"
      [[ "$name" == .* ]] && continue
      [[ -d "$path" ]] || continue
      [[ -f "$path/SKILL.md" ]] || continue
      printf '%s\n' "$name"
    done
  ) | LC_ALL=C sort
}

# dest 里由本脚本管理的条目：软链解析后落在 source 下（含断链）。
is_ours() {
  local entry="$1" target resolved
  if [[ ! -L "$entry" ]]; then
    return 1
  fi
  target="$(readlink "$entry")"
  resolved="$(normjoin "$(dirname "$entry")" "$target")"
  if [[ "$(is_under "$resolved" "$SOURCE")" == "yes" ]]; then
    return 0
  fi
  return 1
}

log() {
  printf '%s\n' "$*"
}

planned=0
errors=0

record() {
  planned=$((planned + 1))
  log "$1"
}

fail() {
  errors=$((errors + 1))
  log "error: $1" >&2
}

apply_link() {
  local name="$1"
  local dest_entry="$DEST/$name"
  local wanted
  wanted="$(relpath "$SOURCE/$name" "$DEST")"

  if [[ -L "$dest_entry" ]]; then
    if [[ "$(readlink "$dest_entry")" == "$wanted" ]]; then
      return 0
    fi
    if is_ours "$dest_entry"; then
      record "replace $name -> $wanted"
      if [[ "$CHECK" -eq 0 && "$DRY_RUN" -eq 0 ]]; then
        ln -sfn "$wanted" "$dest_entry"
      fi
      return 0
    fi
    fail "$dest_entry exists as a symlink to $(readlink "$dest_entry"); not replacing"
    return 1
  fi

  if [[ -e "$dest_entry" ]]; then
    fail "$dest_entry exists and is not a symlink (vendor copy?); not replacing"
    return 1
  fi

  record "link $name -> $wanted"
  if [[ "$CHECK" -eq 0 && "$DRY_RUN" -eq 0 ]]; then
    mkdir -p "$DEST"
    ln -s "$wanted" "$dest_entry"
  fi
}

prune_stale() {
  local path name
  shopt -s nullglob
  for path in "$DEST"/*; do
    name="$(basename "$path")"
    if ! is_ours "$path"; then
      continue
    fi
    if [[ -d "$SOURCE/$name" && -f "$SOURCE/$name/SKILL.md" ]]; then
      continue
    fi
    record "remove stale $name"
    if [[ "$CHECK" -eq 0 && "$DRY_RUN" -eq 0 ]]; then
      rm "$path"
    fi
  done
  shopt -u nullglob
}

run() {
  if [[ ! -d "$SOURCE" ]]; then
    echo "error: source is not a directory: $SOURCE" >&2
    exit 1
  fi

  local name
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    apply_link "$name" || true
  done < <(list_skills "$SOURCE")

  if [[ -d "$DEST" ]]; then
    prune_stale
  elif [[ "$CHECK" -eq 1 ]]; then
    local count
    count="$(list_skills "$SOURCE" | wc -l | tr -d ' ')"
    if [[ "$count" -gt 0 ]]; then
      fail "dest does not exist: $DEST"
    fi
  fi

  if [[ "$errors" -gt 0 ]]; then
    exit 1
  fi
  if [[ "$CHECK" -eq 1 && "$planned" -gt 0 ]]; then
    log "check failed: $planned change(s) needed"
    exit 1
  fi
  if [[ "$CHECK" -eq 1 ]]; then
    log "ok: $DEST is in sync with $SOURCE"
    return 0
  fi
  if [[ "$DRY_RUN" -eq 1 ]]; then
    log "dry-run: $planned action(s)"
    return 0
  fi
  if [[ "$planned" -eq 0 ]]; then
    log "ok: already in sync"
  else
    log "ok: $planned action(s)"
  fi
}

run_self_test() {
  local tmp src dest out
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/link-agent-skills.XXXXXX")"
  src="$tmp/extensions/skills"
  dest="$tmp/.agents/skills"
  mkdir -p "$src/alpha" "$src/beta" "$dest"
  printf '%s\n' '---' 'name: alpha' 'description: a' '---' >"$src/alpha/SKILL.md"
  printf '%s\n' '---' 'name: beta' 'description: b' '---' >"$src/beta/SKILL.md"

  "$0" --source "$src" --dest "$dest" >/dev/null
  [[ "$(readlink "$dest/alpha")" == "../../extensions/skills/alpha" ]]
  [[ "$(readlink "$dest/beta")" == "../../extensions/skills/beta" ]]
  [[ -f "$dest/alpha/SKILL.md" ]]
  "$0" --source "$src" --dest "$dest" --check >/dev/null

  # idempotent
  out="$("$0" --source "$src" --dest "$dest")"
  [[ "$out" == "ok: already in sync" ]]

  # vendor copy must not be replaced, even if source grows the same name
  mkdir -p "$dest/vendor" "$src/vendor"
  printf '%s\n' '---' 'name: vendor' 'description: copy' '---' >"$dest/vendor/SKILL.md"
  printf '%s\n' '---' 'name: vendor' 'description: src' '---' >"$src/vendor/SKILL.md"
  if "$0" --source "$src" --dest "$dest" >/dev/null 2>"$tmp/conflict.err"; then
    echo "error: self-test expected conflict on vendor copy" >&2
    rm -rf "$tmp"
    exit 1
  fi
  grep -q 'not replacing' "$tmp/conflict.err"
  [[ -f "$dest/vendor/SKILL.md" ]]
  [[ ! -L "$dest/vendor" ]]
  rm -rf "$src/vendor"

  # stale ours-link is removed
  ln -s "../../extensions/skills/gone" "$dest/gone"
  "$0" --source "$src" --dest "$dest" >/dev/null
  [[ ! -e "$dest/gone" && ! -L "$dest/gone" ]]

  # --check fails when a link is missing
  rm "$dest/beta"
  if "$0" --source "$src" --dest "$dest" --check >/dev/null 2>"$tmp/check.err"; then
    echo "error: self-test expected --check to fail after deleting a link" >&2
    rm -rf "$tmp"
    exit 1
  fi

  rm -rf "$tmp"
  log "ok: self-test passed"
}

if [[ "$SELF_TEST" -eq 1 ]]; then
  run_self_test
  exit 0
fi

run
