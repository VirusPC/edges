# Submit Mode: 'direct' (default, commit to base branch) or 'pr' (new branch + PR)
EDGES_MODE=direct

# MCP Server Auth (Required for HTTP mode)
EDGES_AUTH_TOKEN=

# PR Creation (Optional - only used in 'pr' mode)
# Not needed if 'gh' CLI is authenticated.
# Get token from: https://github.com/settings/tokens (needs 'repo' scope)
GITHUB_TOKEN=
