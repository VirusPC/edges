#!/bin/bash
# Root-owned nginx site-layout migrator.
# Installed at /usr/local/sbin/edges-migrate-site-layout.
# sudoers allows this absolute path only, with no arguments.
# It does not read the repository worktree and does not accept config paths
# from the caller. Helpers live in /usr/local/lib/edges/site-layout/.
set -euo pipefail

die() {
  printf '%s\n' "$*" >&2
  exit 1
}

# stat -c %a may include a leading special-bit digit (1755, 2755, 0775).
# The last three digits are owner, group, other.
mode_grants_group_or_other_write() {
  local mode=$1
  local tail=${mode: -3}
  local group=$((8#${tail:1:1}))
  local other=$((8#${tail:2:1}))
  [ $((group & 2)) -ne 0 ] || [ $((other & 2)) -ne 0 ]
}

require_root_owned() {
  local path=$1
  local kind=$2
  if [ -L "$path" ]; then
    die "$path is a symlink; reinstall with sudo bash extensions/services/artifacts-preview/deploy/install-site-layout.sh"
  fi
  if [ "$kind" = dir ]; then
    [ -d "$path" ] || die "missing $path"
  else
    [ -f "$path" ] || die "missing $path"
  fi
  local uid mode
  uid=$(/usr/bin/stat -c %u "$path")
  mode=$(/usr/bin/stat -c %a "$path")
  [ "$uid" = 0 ] || die "$path is not owned by root"
  if mode_grants_group_or_other_write "$mode"; then
    die "$path is writable by group or others"
  fi
}

if [ "${BASH_SOURCE[0]}" != "$0" ]; then
  return 0
fi

if [ "$#" -ne 0 ]; then
  echo "edges-migrate-site-layout takes no arguments" >&2
  exit 2
fi

lib_dir=/usr/local/lib/edges/site-layout
require_root_owned "$lib_dir" dir
require_root_owned /usr/local dir
require_root_owned /usr/local/lib dir
require_root_owned /usr/local/lib/edges dir
require_root_owned "$lib_dir/migrate-site-layout.sh" file
require_root_owned "$lib_dir/migrate-teaching-nginx-prefix.py" file

export PATH=/usr/sbin:/usr/bin:/bin
exec /bin/bash /usr/local/lib/edges/site-layout/migrate-site-layout.sh \
  /etc/nginx/conf.d/teaching.conf \
  /etc/nginx/snippets/edges-tasks.conf
