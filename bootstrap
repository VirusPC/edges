#!/usr/bin/env bash
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
BIN_DIR="$SCRIPT_DIR/bin"
ENV_FILE="$SCRIPT_DIR/.env"
RC_FILES=("$HOME/.zshrc" "$HOME/.bash_profile")
MARKER="# edges bin"

add_path() {
  local rc_file="$1"
  local export_line="export PATH=\"$BIN_DIR:\$PATH\""
  
  if grep -qF "$BIN_DIR" "$rc_file" 2>/dev/null; then
    echo "Already configured: $rc_file"
  else
    echo "" >> "$rc_file"
    echo "$MARKER" >> "$rc_file"
    echo "$export_line" >> "$rc_file"
    echo "Added to: $rc_file"
  fi
}

remove_path() {
  local rc_file="$1"
  if grep -qF "$BIN_DIR" "$rc_file" 2>/dev/null; then
    # Remove the marker line and the export line
    sed -i '' "/$MARKER/d" "$rc_file"
    sed -i '' "\|$BIN_DIR|d" "$rc_file"
    echo "Removed from: $rc_file"
  else
    echo "Not found in: $rc_file"
  fi
}

if [ "$1" = "--uninstall" ] || [ "$1" = "-u" ]; then
  for rc_file in "${RC_FILES[@]}"; do
    [ -f "$rc_file" ] && remove_path "$rc_file"
  done
  echo "Done. Restart terminal to apply."
else
  chmod +x "$BIN_DIR"/*
  for rc_file in "${RC_FILES[@]}"; do
    [ -f "$rc_file" ] || touch "$rc_file"
    add_path "$rc_file"
    # Add .env sourcing if not present
    if [ -f "$ENV_FILE" ] && ! grep -qF "source \"$ENV_FILE\"" "$rc_file" 2>/dev/null; then
      echo "source \"$ENV_FILE\"" >> "$rc_file"
      echo "Added .env sourcing to: $rc_file"
    fi
  done
  export PATH="$BIN_DIR:$PATH"
  [ -f "$ENV_FILE" ] && source "$ENV_FILE"
  echo ""
  echo "PATH exported for current session."
  echo "New terminals will auto-load."
fi
