{
  "name": "edges",
  "private": true,
  "version": "1.0.0",
  "description": "Edges - 认知系统服务工作区",
  "scripts": {
    "setup": "./bootstrap",
    "skills:install": "npx skills add ./extensions/skills -g -a claude-code -a codex -a cursor -a gemini-cli -a droid -a opencode -y",
    "build": "pnpm recursive build",
    "test": "pnpm recursive test",
    "lint": "pnpm recursive lint",
    "format": "pnpm recursive exec -- prettier --write \"src/**/*.ts\"",
    "start:note-server": "pnpm --filter new-note start",
    "dev:note-server": "pnpm --filter new-note dev",
    "mcp:run": "pnpm --filter"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
