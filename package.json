{
  "name": "edges",
  "private": true,
  "version": "1.7.0",
  "license": "MIT",
  "description": "Edges - 认知系统服务工作区",
  "scripts": {
    "setup": "./scripts/setup",
    "skills:link": "./scripts/link-agent-skills",
    "skills:install-claude-global": "npx -y skills@1.7.2 add ./packages/skills -g -a claude-code -y",
    "build": "pnpm recursive run build",
    "test": "pnpm recursive run test",
    "lint": "pnpm recursive lint",
    "format": "pnpm recursive exec -- prettier --write \"src/**/*.ts\"",
    "start:note-server": "pnpm --filter new-note start",
    "dev:note-server": "pnpm --filter new-note dev",
    "start:artifacts": "pnpm --filter edges-artifacts-preview start",
    "dev:artifacts": "pnpm --filter edges-artifacts-preview dev",
    "start:evaluation": "pnpm --filter edges-evaluation start",
    "cli:notes": "pnpm --filter @viruspc/edges exec tsx src/index.ts notes",
    "mcp:run": "pnpm --filter",
    "migrate:recursive-layout": "pnpm --filter @viruspc/edges exec tsx ../../scripts/migrations/migrate-recursive-layout.mts",
    "restore:local-ownership": "pnpm --filter @viruspc/edges exec tsx ../../scripts/migrations/restore-local-ownership.mts",
    "migrate:directory-nodes": "pnpm --filter @viruspc/edges exec tsx ../../scripts/migrations/migrate-directory-nodes.mts",
    "migrate:top-level-layout": "pnpm --filter @viruspc/edges exec tsx ../../scripts/migrations/flatten-content-layout.mts",
    "migrate:content-units": "pnpm --filter @viruspc/edges exec tsx ../../scripts/migrations/migrate-content-units.mts",
    "migrate:task-indexes": "pnpm --filter @viruspc/edges exec tsx ../../scripts/migrations/index-task-nodes.mts",
    "migrate:project-harness-markers": "pnpm --filter @viruspc/edges exec tsx ../../scripts/migrations/rewrite-project-harness-markers.mts",
    "migrate:type-index-readme": "pnpm --filter @viruspc/edges exec tsx ../../scripts/migrations/migrate-type-index-to-readme.mts",
    "migrate:split-type-index-readme": "pnpm --filter @viruspc/edges exec tsx ../../scripts/migrations/split-type-index-readme.mts",
    "migrate:index-case": "pnpm --filter @viruspc/edges exec tsx ../../scripts/migrations/migrate-index-to-INDEX.mts",
    "migrate:task-project-lists": "pnpm --filter @viruspc/edges exec tsx ../../scripts/migrations/migrate-task-project-lists.mts",
    "migrate:harness-readme-index": "pnpm --filter @viruspc/edges exec tsx ../../scripts/migrations/migrate-harness-readme-index.mts"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.7+sha512.ba98abc585539933375b5971f4bc6d6c73a1b4b7edc4a879e7d102fe5423d1e02309d67c60a11f04955093a96e521ad9c3b138cdd654ca5be563f378b3ae48bd",
  "devDependencies": {
    "@types/node": "^22.19.11",
    "typescript": "^5.0.0"
  }
}
