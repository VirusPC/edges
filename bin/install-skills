#!/usr/bin/env bash
#
# 把 extensions/skills/ 里的 skill 分发到本机各 agent 的全局配置目录。
#
# 采用两跳软链，仓库绝对路径只出现在中枢这一层，仓库搬家重跑一次即可：
#
#   ~/.agents/skills/<name>  ->  <repo>/extensions/skills/<name>   (绝对)
#   ~/.claude/skills/<name>  ->  ../../.agents/skills/<name>       (相对)
#
# 逐个 skill 软链而非整目录软链——各 agent 目录里混着别处装的 skill，不能覆盖。
#
# 兼容 bash 3.2（macOS 自带版本），勿使用 mapfile / 关联数组。
#
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SRC_DIR="$ROOT_DIR/extensions/skills"

# 中枢目录，相对 $HOME
HUB_REL=".agents/skills"
HUB_DIR="$HOME/$HUB_REL"

# 各 agent 的全局 skills 目录，相对 $HOME
TARGETS=(
  ".claude/skills"
  ".codex/skills"
  ".cursor/skills"
  ".gemini/skills"
  ".factory/skills"
  ".config/opencode/skills"
)

MODE="install"
case "${1:-}" in
  --dry-run)   MODE="dry-run" ;;
  --list)      MODE="list" ;;
  --uninstall) MODE="uninstall" ;;
  --help|-h)
    sed -n '3,11p' "${BASH_SOURCE[0]}" | sed 's/^#\ \{0,1\}//'
    echo "用法: install-skills [--dry-run | --list | --uninstall | --help]"
    exit 0
    ;;
  "") ;;
  *)
    echo "未知参数: $1 (试试 --help)" >&2
    exit 2
    ;;
esac

WARNINGS=0
SKILLS=()

say()  { echo "[install-skills] $*"; }
warn() { echo "[install-skills] warning: $*" >&2; WARNINGS=$((WARNINGS + 1)); }

# 计算从 $HOME/<rel> 回到 $HOME 的相对前缀，如 .claude/skills -> ../../
up_prefix() {
  local rel="$1" depth prefix="" i
  depth=$(printf '%s' "$rel" | tr '/' '\n' | grep -c .)
  i=0
  while [ "$i" -lt "$depth" ]; do
    prefix="$prefix../"
    i=$((i + 1))
  done
  printf '%s' "$prefix"
}

# 收集合法 skill 到 SKILLS：目录下有 SKILL.md，且 frontmatter name 与目录名一致。
# 在主 shell 里跑（不用子 shell），这样 warn 的计数能累加。
collect_skills() {
  local dir name skill_md fm_name
  for dir in "$SRC_DIR"/*/; do
    [ -d "$dir" ] || continue
    name="$(basename "$dir")"
    skill_md="$dir/SKILL.md"

    if [ ! -f "$skill_md" ]; then
      warn "$name 缺少 SKILL.md，跳过（agent 无法加载）"
      continue
    fi

    fm_name="$(grep -m1 '^name:' "$skill_md" 2>/dev/null | sed "s/^name: *//; s/[\"']//g; s/[[:space:]]*$//")" || true
    if [ -z "$fm_name" ]; then
      warn "$name 的 SKILL.md 缺少 frontmatter name 字段，跳过"
      continue
    fi
    if [ "$fm_name" != "$name" ]; then
      warn "$name 的 frontmatter name 是 '$fm_name'，与目录名不一致，跳过"
      continue
    fi

    SKILLS[${#SKILLS[@]}]="$name"
  done
}

# 判断软链是否由本仓库安装：中枢层指向 SRC_DIR，fan-out 层指向中枢
links_to_src() {
  [ -L "$1" ] && [ "$(readlink "$1")" = "$SRC_DIR/$2" ]
}

links_to_hub() {
  local target
  [ -L "$1" ] || return 1
  target="$(readlink "$1")"
  case "$target" in
    *"/$HUB_REL/$2") return 0 ;;
    *) return 1 ;;
  esac
}

# $1 软链路径  $2 skill 名  $3 期望的 link target  $4 人类可读标签
make_link() {
  local path="$1" target="$3" label="$4"

  if [ -e "$path" ] && [ ! -L "$path" ]; then
    warn "$label 已是实体目录（别处装的同名 skill），跳过，不覆盖"
    return
  fi

  if [ -L "$path" ]; then
    if [ "$(readlink "$path")" = "$target" ]; then
      [ "$MODE" = "dry-run" ] && say "  = $label (已是最新)"
      return 0
    fi
    warn "$label 是指向别处的软链（-> $(readlink "$path")），跳过，不覆盖"
    return
  fi

  if [ "$MODE" = "dry-run" ]; then
    say "  + $label -> $target"
  else
    ln -sfn "$target" "$path"
  fi
}

remove_link() {
  if [ "$MODE" = "dry-run" ]; then
    say "  - $2"
  else
    rm -f "$1"
  fi
}

# ---------------------------------------------------------------- main

if [ ! -d "$SRC_DIR" ]; then
  echo "[install-skills] 源目录不存在: $SRC_DIR" >&2
  exit 1
fi

collect_skills

if [ "${#SKILLS[@]}" -eq 0 ]; then
  echo "[install-skills] $SRC_DIR 下没有找到合法 skill" >&2
  exit 1
fi

if [ "$MODE" = "list" ]; then
  say "源: $SRC_DIR"
  for name in "${SKILLS[@]}"; do
    installed=0
    for rel in "${TARGETS[@]}"; do
      if links_to_hub "$HOME/$rel/$name" "$name"; then
        installed=$((installed + 1))
      fi
    done
    hub_ok="-"
    links_to_src "$HUB_DIR/$name" "$name" && hub_ok="hub"
    printf '  %-32s %-4s %d/%d\n' "$name" "$hub_ok" "$installed" "${#TARGETS[@]}"
  done
  exit 0
fi

if [ "$MODE" = "uninstall" ]; then
  say "卸载（只删除指向本仓库的软链）"
  for name in "${SKILLS[@]}"; do
    for rel in "${TARGETS[@]}"; do
      if links_to_hub "$HOME/$rel/$name" "$name"; then
        remove_link "$HOME/$rel/$name" "~/$rel/$name"
      fi
    done
    if links_to_src "$HUB_DIR/$name" "$name"; then
      remove_link "$HUB_DIR/$name" "~/$HUB_REL/$name"
    fi
  done
  say "done"
  exit 0
fi

[ "$MODE" = "dry-run" ] && say "dry-run，不做任何改动"
say "源: $SRC_DIR (${#SKILLS[@]} 个 skill)"

# 第一跳：中枢 -> 仓库
[ "$MODE" = "dry-run" ] || mkdir -p "$HUB_DIR"
say "中枢 ~/$HUB_REL"
for name in "${SKILLS[@]}"; do
  make_link "$HUB_DIR/$name" "$name" "$SRC_DIR/$name" "~/$HUB_REL/$name"
done

# 第二跳：各 agent -> 中枢
for rel in "${TARGETS[@]}"; do
  [ "$MODE" = "dry-run" ] || mkdir -p "$HOME/$rel"
  prefix="$(up_prefix "$rel")"
  say "~/$rel"
  for name in "${SKILLS[@]}"; do
    make_link "$HOME/$rel/$name" "$name" "$prefix$HUB_REL/$name" "~/$rel/$name"
  done
done

if [ "$WARNINGS" -gt 0 ]; then
  say "done（$WARNINGS 条 warning，见上）"
else
  say "done"
fi
