#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SRC_DIR="$ROOT_DIR/extensions/skills"

TARGETS=(
  ".codex/skills"
  ".claude/skills"
  ".cursor/skills"
  ".gemini/skills"
  ".opencode/skills"
  ".agent/skills"
)

if [[ ! -d "$SRC_DIR" ]]; then
  echo "[init-extensions] source not found: $SRC_DIR" >&2
  exit 1
fi

sync_target() {
  local target_rel="$1"
  local target_dir="$ROOT_DIR/$target_rel"

  mkdir -p "$target_dir"

  if command -v rsync >/dev/null 2>&1; then
    rsync -a --exclude '.gitkeep' "$SRC_DIR/" "$target_dir/"
  else
    find "$SRC_DIR" -mindepth 1 -maxdepth 1 ! -name '.gitkeep' -exec cp -R {} "$target_dir/" \;
  fi

  echo "[init-extensions] merged extensions -> $target_rel"
}

for target in "${TARGETS[@]}"; do
  sync_target "$target"
done

echo "[init-extensions] done"
