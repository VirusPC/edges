# Written by: edges artifacts server install
# (create token if missing; --force may rotate). Never commit the real token.
# Laptop client: edges artifacts init --base-url https://edges.viruspc.tech
# then paste the same EDGES_ARTIFACTS_TOKEN into ~/.config/edges/artifacts.env.

EDGES_ARTIFACTS_TOKEN=replace-with-shared-token
EDGES_ARTIFACTS_BASE_URL=https://edges.viruspc.tech
EDGES_ARTIFACTS_HOST=127.0.0.1
EDGES_ARTIFACTS_PORT=8787
EDGES_ARTIFACTS_DATA_DIR=/home/cheng-dev/.local/share/edges-artifacts
