# Copy to ~/.config/edges/artifacts-preview.env on the ECS (mode 0600).
# Never commit the real token. Generate one with:
#   edges artifacts init --base-url http://182.92.131.89
# then paste the printed EDGES_ARTIFACTS_TOKEN here. Use the same token
# in the laptop/client ~/.config/edges/artifacts.env.

EDGES_ARTIFACTS_TOKEN=replace-with-shared-token
EDGES_ARTIFACTS_BASE_URL=http://182.92.131.89
EDGES_ARTIFACTS_HOST=127.0.0.1
EDGES_ARTIFACTS_PORT=8787
EDGES_ARTIFACTS_DATA_DIR=/home/cheng-dev/.local/share/edges-artifacts
