[Unit]
Description=Edges artifacts preview (ADR 0013)
Documentation=https://github.com/VirusPC/edges/blob/main/extensions/services/artifacts-preview/README.md
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/.config/edges/artifacts-preview.env

[Service]
Type=simple
WorkingDirectory=%h/projects/edges
Environment=PATH=/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/edges/artifacts-preview.env
ExecStart=/usr/bin/env node %h/projects/edges/extensions/services/artifacts-preview/dist/index.js
Restart=on-failure
RestartSec=2
NoNewPrivileges=true

[Install]
WantedBy=default.target
