# Shape of Aliyun ECS /etc/nginx/conf.d/teach.conf before the /teaching/ migration.
# Two server blocks (80 + 443 ssl), location /teach/, root .../knowledge.
# SSL paths are placeholders; do not commit real certs.

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name teach.viruspc.tech aliyun.viruspc.tech _;
    root /home/cheng-dev/projects/edges/knowledge;
    index index.html;
    # do not force HTTP→HTTPS (Cloudflare Flexible loop risk)
    location /teach/ {
        try_files $uri $uri/ =404;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name teach.viruspc.tech aliyun.viruspc.tech _;
    ssl_certificate /etc/nginx/ssl/origin.pem;
    ssl_certificate_key /etc/nginx/ssl/origin.key;
    root /home/cheng-dev/projects/edges/knowledge;
    index index.html;
    location /teach/ {
        try_files $uri $uri/ =404;
    }
}
