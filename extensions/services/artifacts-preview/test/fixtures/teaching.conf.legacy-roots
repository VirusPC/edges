server {
    listen 80;
    # shared root for unrelated locations
    root /srv/edges/knowledge;
    location = / { return 200 "other homepage"; }
    location = /teach { return 301 /teaching/; }
    location /teach/ { rewrite ^/teach/(.*)$ /teaching/$1 permanent; }
    location /teaching/ {
        try_files $uri $uri/ =404;
    }
    location /other/ { root /srv/edges/knowledge; }
    location /assets/ { alias /srv/edges/knowledge/teaching/assets/; }
}
server {
    listen 443 ssl;
    root /srv/unrelated;
    location = / { return 301 /teaching/; }
    location = /teach { return 301 /teaching/; }
    location /teach/ { rewrite ^/teach/(.*)$ /teaching/$1 permanent; }
    location /teaching/ {
        root /srv/edges/knowledge;
        try_files $uri $uri/ =404;
    }
    location /teaching/assets/ { alias /srv/edges/knowledge/teaching/assets/; }
}
server {
    listen 8080;
    root /srv/edges/knowledge;
    location /other/ { try_files $uri =404; }
}
