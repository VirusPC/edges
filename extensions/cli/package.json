{
  "name": "edges-cli",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Multi-command Edges CLI (note ingest, tasks, and more)",
  "bin": {
    "edges": "./dist/index.js"
  },
  "scripts": {
    "build:tasks-review-app": "pnpm --filter tasks-review-app run build",
    "build": "pnpm run build:tasks-review-app && tsc -p tsconfig.json && node ./scripts/copy-review-page-asset.mjs && node --import tsx ./scripts/copy-memory-templates.ts",
    "prepack": "pnpm run build",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "dev:tasks-review-app": "pnpm --filter tasks-review-app run dev",
    "test": "pnpm run build:tasks-review-app && node --test --import tsx './test/**/*.test.ts'"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "diff": "8.0.4",
    "gray-matter": "^4.0.3",
    "mdast-util-from-markdown": "^2.0.3",
    "tar": "^7.5.22",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.19.11",
    "tasks-review-app": "workspace:*",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
