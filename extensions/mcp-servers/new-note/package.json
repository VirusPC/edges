{
  "name": "new-note",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server for ingesting AI summaries into the edges repository",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts --http --port 3000",
    "start": "node dist/index.js --http --port 3000",
    "dev:stdio": "tsx src/index.ts",
    "start:stdio": "node dist/index.js",
    "test": "node --test --import tsx"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.4",
    "express": "^4.22.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.11",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
