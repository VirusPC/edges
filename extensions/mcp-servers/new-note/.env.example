# Git Repository Configuration
EDGES_REPO=/path/to/your/repository
EDGES_BASE_BRANCH=main

# Authorization Configuration (optional - for auto PR creation)
# Get token from: https://github.com/settings/tokens (needs 'repo' scope)
GITHUB_TOKEN=your_github_token_here

# Script Configuration
EDGES_SCRIPT_PATH=./path/to/ingest/script.sh
