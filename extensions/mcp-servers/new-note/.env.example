# Base branch (default: main)
EDGES_BASE_BRANCH=main

# Submit Mode: 'pr' (new branch + PR) or 'direct' (commit to base branch)
EDGES_MODE=direct

# PR Creation (Optional)
# Not needed if using 'new-note-direct' or if 'gh' CLI is authenticated.
# Get token from: https://github.com/settings/tokens (needs 'repo' scope)
GITHUB_TOKEN=your_github_token_here

# MCP Server Auth (Optional - for HTTP mode)
EDGES_AUTH_TOKEN=your_mcp_auth_token_here
